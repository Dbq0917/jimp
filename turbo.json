{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "JIMP_DECODE_MAX_WIDTH",
    "JIMP_DECODE_MAX_HEIGHT",
    "JIMP_DECODE_MAX_PIXELS",
    "JIMP_DECODE_MAX_MEMORY"
  ],
  "tasks": {
    "build": {
      "outputs": ["dist/**"],
      "dependsOn": ["^build"]
    },
    "build:browser": {
      "outputs": ["browser.js"],
      "dependsOn": ["^build", "^build:browser"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build", "^test"]
    },
    "test:browser": {
      "dependsOn": ["^build", "^test:browser"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
